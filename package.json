{
  "name": "playwright-e2e-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "E2E test automation portfolio: Playwright + TypeScript tests for a demo e-commerce site, run N rounds on GitHub Actions with a public bilingual results dashboard.",
  "license": "MIT",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:dashboard": "playwright test -c playwright.dashboard.config.ts",
    "rounds": "node scripts/run-rounds.mjs",
    "aggregate": "node scripts/aggregate.mjs",
    "report": "playwright show-report test-output/local/report",
    "site": "node scripts/publish.mjs && node scripts/build-site.mjs",
    "serve": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "check:config": "node scripts/check-config.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "24.0.9",
    "eslint": "10.10.0",
    "eslint-plugin-playwright": "2.12.0",
    "globals": "17.12.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0"
  }
}
